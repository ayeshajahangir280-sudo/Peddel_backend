# Copy to .env for local development. NEVER commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL (production). Leave unset locally to use SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Redis for Channels (WebSocket fan-out across workers). Optional.
REDIS_URL=
# Public site (share links / QR codes) and every site allowed to call the API (public site + admin, comma-separated)
FRONTEND_URL=https://tournaments.example.com
CORS_ORIGIN=https://tournaments.example.com,https://admin.example.com
# Image uploads (players / tournament logos). Leave unset locally to store files on disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Peddel
# First Super Admin (created once on startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
