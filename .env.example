# Copy to .env for local development. NEVER commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com
# PostgreSQL (production). Leave unset locally to use SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Redis for Channels (WebSocket fan-out across workers). Optional locally.
REDIS_URL=redis://redis:6379/0
# Frontend origins
PUBLIC_SITE_URL=https://tournaments.example.com
CORS_ALLOWED_ORIGINS=https://tournaments.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
WS_ALLOWED_ORIGINS=https://tournaments.example.com,https://admin.example.com
# Uploads (mount a persistent volume here)
MEDIA_ROOT=/data/media
MAX_UPLOAD_BYTES=5242880
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO
# Rate limits (DRF format). Login limit is per client IP.
THROTTLE_LOGIN=10/min
THROTTLE_ANON=240/min
THROTTLE_USER=1200/min
